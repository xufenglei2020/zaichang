---
import { site } from '../site.config';

const giscus = site.giscus;
---

<section class="comments" aria-labelledby="comments-heading">
  <h2 id="comments-heading">{site.commentsHeading}</h2>
  <div class="giscus-wrap" data-giscus-host></div>
</section>

<script define:vars={{ giscus }}>
  const host = document.querySelector('[data-giscus-host]');
  if (host && !host.querySelector('script')) {
    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';
    script.setAttribute('data-repo', giscus.repo);
    script.setAttribute('data-repo-id', giscus.repoId);
    script.setAttribute('data-category', giscus.category);
    if (giscus.categoryId) {
      script.setAttribute('data-category-id', giscus.categoryId);
    }
    script.setAttribute('data-mapping', giscus.mapping);
    script.setAttribute('data-strict', '0');
    script.setAttribute('data-reactions-enabled', '0');
    script.setAttribute('data-emit-metadata', '0');
    script.setAttribute('data-input-position', 'bottom');
    script.setAttribute('data-theme', giscus.theme);
    script.setAttribute('data-lang', giscus.lang);
    script.setAttribute('data-loading', 'lazy');
    host.appendChild(script);
  }
</script>
