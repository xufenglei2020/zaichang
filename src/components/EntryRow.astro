---
import { entryHref, formatDateShort, type JournalEntry } from '../lib/journal';
import { withBase } from '../lib/paths';

interface Props {
  entry: JournalEntry;
  all: JournalEntry[];
}

const { entry, all } = Astro.props;
const href = entryHref(entry, all);
const cover = entry.data.cover ? withBase(entry.data.cover) : undefined;
---

<a class="entry" href={href}>
  {
    cover && (
      <img
        class="entry-still"
        src={cover}
        alt=""
      />
    )
  }
  <div class="entry-body">
    <h2 class="entry-city">{entry.data.city}</h2>
    {entry.data.excerpt && <p class="excerpt">{entry.data.excerpt}</p>}
    <p class="entry-date">
      <time datetime={entry.data.date.toISOString().slice(0, 10)}>
        {formatDateShort(entry.data.date)}
      </time>
    </p>
  </div>
</a>
