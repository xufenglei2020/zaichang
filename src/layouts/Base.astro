---
import '../styles/global.css';
import { site } from '../site.config';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
}

const { title, description = site.description, ogTitle } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.subtitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const path = rawPath === base || rawPath === '' ? '/' : rawPath.slice(base.length) || '/';
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase('/rss.xml')} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={ogTitle ?? pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500&family=Noto+Sans+SC:wght@400;500&family=Noto+Serif+SC:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#content">跳到正文</a>
    <header class="site-header">
      <div class="wrap header-inner">
        {
          path === '/' ? (
            <span class="wordmark" aria-hidden="true"></span>
          ) : (
            <a class="wordmark" href={withBase('/')}>{site.title}</a>
          )
        }
        <nav class="nav" aria-label="栏目">
          <a href={withBase('/')} aria-current={path === '/' ? 'page' : undefined}>{site.navIndex}</a>
          <a href={withBase('/about')} aria-current={path === '/about' ? 'page' : undefined}>{site.navAbout}</a>
        </nav>
      </div>
    </header>
    <main id="content" class="site-main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">© {site.author} · {site.title}</div>
    </footer>
  </body>
</html>
