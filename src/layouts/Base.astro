---
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource/noto-serif-sc/chinese-simplified-400.css';
import '@fontsource/noto-serif-sc/chinese-simplified-500.css';
import '../styles/global.css';
import { site } from '../site.config';
import { withBase } from '../lib/paths';
import { getPublishedEntries } from '../lib/journal';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogImage?: string;
}

const { title, description = site.description, ogTitle, ogImage: ogImageProp } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.subtitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const path = rawPath === base || rawPath === '' ? '/' : rawPath.slice(base.length) || '/';

function toAbsolute(url: string): string {
  return new URL(url, Astro.site).href;
}

let ogImage = ogImageProp;
if (!ogImage) {
  const published = await getPublishedEntries();
  const fallback = published.find((entry) => entry.data.cover)?.data.cover;
  if (fallback) ogImage = toAbsolute(withBase(fallback));
}
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase('/rss.xml')} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={ogTitle ?? pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body>
    <a class="skip" href="#content">{site.skipToContent}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        {
          path === '/' ? (
            <span class="wordmark" aria-hidden="true"></span>
          ) : (
            <a class="wordmark" href={withBase('/')}>{site.title}</a>
          )
        }
        <nav class="nav" aria-label="栏目">
          <a href={withBase('/')} aria-current={path === '/' ? 'page' : undefined}>{site.navIndex}</a>
          <a href={withBase('/about')} aria-current={path === '/about' ? 'page' : undefined}>{site.navAbout}</a>
        </nav>
      </div>
    </header>
    <main id="content" class="site-main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">{site.title}</div>
    </footer>
  </body>
</html>
