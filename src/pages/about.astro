---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---

<Base title={site.navAbout} description={site.description}>
  <article class="about">
    <p class="about-kicker">{site.about.kicker}</p>
    <h1>{site.about.title}</h1>
    {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p class="about-stanza" set:html={site.about.close.join('<br />')} />
  </article>
</Base>
