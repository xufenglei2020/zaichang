---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---

<Base title={site.navAbout} description={site.description}>
  <article class="about">
    <p class="about-kicker">{site.about.kicker}</p>
    <h1>{site.about.title}</h1>
    {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <div class="about-close">
      {site.about.close.map((line) => <p>{line}</p>)}
    </div>

    <section class="about-project">
      <h2>{site.project.title}</h2>
      {site.project.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <div class="about-close">
        {site.project.close.map((line) => <p>{line}</p>)}
      </div>
    </section>
  </article>
</Base>
