---
import Base from '../layouts/Base.astro';
import EntryRow from '../components/EntryRow.astro';
import { site } from '../site.config';
import { getPublishedEntries, groupByYear } from '../lib/journal';

const entries = await getPublishedEntries();
const years = groupByYear(entries);
---

<Base>
  <header class="masthead">
    <h1>{site.title}</h1>
    <p class="subtitle">{site.subtitle}</p>
  </header>

  {
    entries.length === 0 ? (
      <p class="empty">{site.empty}</p>
    ) : (
      years.map(({ year, entries: yearEntries }) => (
        <section class="year-block" aria-labelledby={`y-${year}`}>
          <h2 class="year-label" id={`y-${year}`}>{year}</h2>
          <ol class="entry-list">
            {yearEntries.map((entry) => (
              <li>
                <EntryRow entry={entry} all={entries} />
              </li>
            ))}
          </ol>
        </section>
      ))
    )
  }
</Base>
